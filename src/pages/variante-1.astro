---
import Base from "../variants/Base.astro";
import App from "../variants/v1/App";
import { loadImages } from "../variants/images";
import "../variants/v1/v1.css";
const { hero, portrait } = await loadImages();
---

<Base
  title="Steff Ramírez · Atelier"
  theme="#efe8dc"
  fonts="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300..700;1,300..700&family=Manrope:wght@400;500;600&display=swap"
>
  <App hero={hero} portrait={portrait} client:load />
</Base>
