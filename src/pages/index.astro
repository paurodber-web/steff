---
import { getImage } from "astro:assets";
import Page from "../v2/Page";
import heroSrc from "../assets/steff-hero.png";
import aboutSrc from "../assets/steff.webp";
import "../v2/v2.css";

const widths = [360, 540, 701];
const variants = await Promise.all(
  widths.map((width) => getImage({ src: heroSrc, format: "webp", quality: 82, width })),
);
const largest = variants[variants.length - 1];
const image = {
  src: largest.src,
  srcSet: variants.map((v, i) => `${v.src} ${widths[i]}w`).join(", "),
  sizes: "(min-width: 1024px) 480px, 340px",
  width: Number(largest.attributes.width ?? heroSrc.width),
  height: Number(largest.attributes.height ?? heroSrc.height),
};

const aboutWidths = [320, 560, 900];
const aboutVariants = await Promise.all(
  aboutWidths.map((width) => getImage({ src: aboutSrc, format: "webp", quality: 80, width })),
);
const aboutLargest = aboutVariants[aboutVariants.length - 1];
const aboutImage = {
  src: aboutLargest.src,
  srcSet: aboutVariants.map((v, i) => `${v.src} ${aboutWidths[i]}w`).join(", "),
  sizes: "(min-width: 1024px) 460px, 380px",
  width: Number(aboutLargest.attributes.width ?? aboutSrc.width),
  height: Number(aboutLargest.attributes.height ?? aboutSrc.height),
};

const title = "Steff Ramírez · UGC Creator";
const description =
  "Steff Ramírez, UGC creator: videos de moda, belleza, lifestyle y maternidad para marcas que quieren conectar con su audiencia.";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f4eee3" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/steff.png" />
    <meta property="og:locale" content="es_LA" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon-v2.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Page image={image} aboutImage={aboutImage} client:load />
  </body>
</html>
