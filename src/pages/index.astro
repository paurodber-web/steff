---
const base = import.meta.env.BASE_URL;
const items = [
  { href: "portada-actual/", name: "Portada actual", note: "La versión que está publicada ahora mismo." },
  { href: "variante-1/", name: "Variante 1 · Reels", note: "La portada se encoge hasta ser la pantalla de un móvil." },
  { href: "variante-2/", name: "Variante 2 · Perfil", note: "Tu web como perfil." },
  { href: "variante-3/", name: "Variante 3 · Editor", note: "Tu web como editor de video." },
  { href: "variante-4/", name: "Variante 4 · Conversación", note: "Burbujas de mensaje y un chat para el brief." },
  { href: "variante-5/", name: "Variante 5 · Tablero", note: "Moodboard con lienzo y minimapa." },
  { href: "variante-6/", name: "Variante 6 · Agenda", note: "Planificador con calendario y Gantt." },
  { href: "variante-7/", name: "Variante 7 · Pila", note: "Una baraja de videos que se reparte con el scroll." },
  { href: "variante-8/", name: "Variante 8 · Stories", note: "Historias destacadas con visor a pantalla completa." },
  { href: "variante-9/", name: "Variante 9 · Notificaciones", note: "Pantalla de bloqueo con notificaciones." },
  { href: "variante-10/", name: "Variante 10 · Explorar", note: "Una búsqueda escribe tu nombre y la portada es el resultado." },
  { href: "variante-11/", name: "Variante 11 · Portfolio", note: "Portfolio limpio y elegante, sección a sección." },
  { href: "variante-12/", name: "Variante 12 · Editorial", note: "Sin tarjetas ni elementos flotantes; tipografía más legible." },
  { href: "variante-13/", name: "Variante 13 · Composiciones", note: "Misma línea, cada sección con su propia composición y animación." },
];
const title = "Índice · Steff Ramírez";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>Índice</h1>
      <ul>
        {items.map((it) => (
          <li>
            <a href={`${base}${it.href}`}>{it.name}</a>
            <p>{it.note}</p>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>

<style>
  body { margin: 0; font-family: system-ui, sans-serif; background: #fff; color: #111; line-height: 1.5; }
  main { max-width: 640px; margin: 0 auto; padding: 24px 16px; }
  h1 { font-size: 1.6rem; margin: 0 0 16px; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { padding: 12px 0; border-bottom: 1px solid #ddd; }
  a { font-weight: 600; color: #111; }
  p { margin: 4px 0 0; font-size: 0.9rem; color: #555; }
</style>
