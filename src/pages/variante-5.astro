---
import Base from "../variants/Base.astro";
import App from "../variants/v5/App";
import { loadImages } from "../variants/images";
import "../v2/v2.css";
import "../variants/v5/v5.css";
const { hero, portrait } = await loadImages();
---

<Base
  title="Steff Ramírez · Tablero"
  theme="#f4eee3"
  fonts="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..800;1,400..800&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=Instrument+Sans:wght@400;500;600&display=swap"
>
  <App hero={hero} portrait={portrait} client:load />
</Base>
