---
interface Props {
  title: string;
  fonts: string;
  theme: string;
}
const { title, fonts, theme } = Astro.props;
const description =
  "Steff Ramírez, UGC creator: videos de moda, belleza, lifestyle y maternidad para marcas que quieren conectar con su audiencia.";
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content={theme} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${import.meta.env.BASE_URL}steff.png`} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon-v2.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts} rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
